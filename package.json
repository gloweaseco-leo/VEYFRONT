{
  "name": "veyfront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:demo && pnpm check:brand && pnpm check:pricing && pnpm check:w0w1 && pnpm check:commercial && pnpm check:ops && pnpm check:contact && pnpm check:seo && pnpm check:locale && pnpm check:security && node scripts/check-veyfront-brand.mjs && next build",
    "start": "next start",
    "check:demo": "node scripts/check-demo-facts.mjs",
    "check:commercial": "node scripts/check-commercial-intake.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:ops": "node scripts/check-lead-ops.mjs",
    "check:security": "node --test tests/lead-request.test.mjs tests/lead-alert.test.mjs tests/lead-confirmation.test.mjs",
    "check:w0w1": "node scripts/check-w0-w1.mjs",
    "check:contact": "node --test tests/contact-validation.test.mjs tests/acquisition-channel.test.mjs tests/acquisition-report.test.mjs && node scripts/check-contact-journey.mjs",
    "check:seo": "node scripts/check-production-seo.mjs && node scripts/check-seo-technical.mjs",
    "check:pricing": "node scripts/check-pricing-v35.mjs",
    "check:locale": "node scripts/check-locale-v2.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "2.6.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
